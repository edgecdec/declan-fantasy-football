# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# betting setup links handout — contains live one-time credentials
setup_links.html

# sqlite (betting). Deliberately NOT `data/` — that directory holds the
# committed player database and rankings JSON.
data/*.db
data/*.db-wal
data/*.db-shm
# Nightly ledger snapshots. The data/*.db* rules above only match files directly in
# data/, not in a subdirectory, so these need their own line.
data/backups/

# ralph
.ralph/.server-env
/tmp/ralph-*-logs/
